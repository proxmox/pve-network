#version:1

auto myvnet
iface myvnet
	bridge_ports none
	bridge_stp off
	bridge_fd 0
	vrf vrf_myzone

auto vrf_myzone
iface vrf_myzone
	vrf-table auto
	post-up ip route add vrf vrf_myzone unreachable default metric 4278198272
	post-up ip -6 route add vrf vrf_myzone unreachable default metric 4278198272 || true
